#!/sbin/openrc-run

name="LocLogPP"
description="Location Logger in C++"

command="/usr/local/bin/loclogpp"
command_args="--syslog ${LOCLOGPP_GLOBAL_ARGS} track ${LOCLOGPP_TRACK_ARGS}"
command_background="true"

pidfile=/var/run/loclogpp.pid

# loclogpp logs everything to stderr
error_logger="logger -t loclogpp --prio-prefix"

depend() {
    need gpsd
}
