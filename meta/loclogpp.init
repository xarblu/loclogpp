#!/sbin/openrc-run

name="LocLogPP"
description="Location Logger in C++"

command="/usr/local/bin/loclogpp"
command_args="${LOCLOGPP_GLOBAL_ARGS} track ${LOCLOGPP_TRACK_ARGS}"
command_background="true"

pidfile=/var/run/loclogpp.pid

# loclogpp logs everything to stderr
error_log=/var/log/loclogpp.log

depend() {
    need gpsd
}
